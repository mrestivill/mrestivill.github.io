---
const { data } = Astro.props;
---
<section class="section">
  <h2>{data.educationTitle}</h2>
  <div class="education-list">
    {data.education.map((item) => (
      <article>
        <div>
          <h3>{item.degree}</h3>
          <p class="company">{item.institution}</p>
        </div>
        <span class="period">{item.period}</span>
      </article>
    ))}
  </div>
</section>
